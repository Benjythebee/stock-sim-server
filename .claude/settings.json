{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run dev)",
      "Bash(bun run start)",
      "Bash(bun run check)",
      "Bash(bun run typecheck)",
      "Bash(bun run simulate:*)",
      "Bash(bun run load:*)",
      "Bash(bun test:*)",
      "Bash(bun scripts/simulate.ts:*)",
      "Bash(bun scripts/load.ts:*)",
      "Bash(bunx tsc --noEmit:*)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Read(../stock-sim-ui/**)"
    ],
    "additionalDirectories": [
      "../stock-sim-ui"
    ]
  }
}
