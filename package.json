{
  "name": "stock-sim-server",
  "module": "./src/index.ts",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch run ./src/index.ts",
    "start": "bun run ./src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "check": "bun run typecheck && bun test",
    "load": "bun run ./scripts/load.ts",
    "simulate": "bun run ./scripts/simulate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
